# kural env config — copy to .env and edit

# Pipeline
KURAL_MODE=voice                       # voice (STT→LLM→TTS) or echo (passthrough)

# Audio
KURAL_SAMPLE_RATE=16000                # input rate (Whisper-optimal)
KURAL_OUTPUT_SAMPLE_RATE=24000         # output rate (TTS playback)
KURAL_LOG_LEVEL=INFO

# LLM provider — registry key in kural/adapters/registry.py.
# Currently registered: openai (OpenAI-compatible HTTP endpoint).
KURAL_LLM_PROVIDER=openai

# LLM (OpenAI-compatible). Examples:
#   OpenAI         base_url=https://api.openai.com/v1
#   OpenRouter     base_url=https://openrouter.ai/api/v1
#   Groq           base_url=https://api.groq.com/openai/v1
#   Ollama (local) base_url=http://localhost:11434/v1
KURAL_LLM_BASE_URL=http://localhost:11434/v1
KURAL_LLM_API_KEY=ollama
KURAL_LLM_MODEL=llama3.1:8b

# STT provider — registry key. Currently registered: whisper (faster-whisper,
# local), deepgram (cloud).
KURAL_STT_PROVIDER=whisper

# STT model identifier.
# whisper (auto-downloaded on first run): tiny.en, base.en, small.en,
#   distil-small.en, distil-medium.en
# deepgram: nova-3-general (default), nova-2-general, ...
KURAL_STT_MODEL=distil-medium.en

# Required when KURAL_STT_PROVIDER=deepgram.
DEEPGRAM_API_KEY=

# TTS provider — registry key. Currently registered: piper (local),
# kokoro (local; `pip install kokoro-onnx==0.4.7 "pipecat-ai[kokoro]" --no-deps`
# first — pipecat's kokoro extra pins a kokoro-onnx floor not yet on PyPI),
# elevenlabs (cloud).
KURAL_TTS_PROVIDER=piper

# TTS voice identifier.
# piper (auto-downloaded on first run): see https://github.com/rhasspy/piper-tts
# kokoro (auto-downloaded on first run): e.g. af_heart, am_michael
# elevenlabs: a voice ID from your ElevenLabs account
KURAL_TTS_VOICE=en_US-amy-medium

# Required when KURAL_TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=

# System prompt seeded into the LLM context.
# KURAL_AGENT_PROMPT="You are kural, a concise and friendly voice assistant."

# --- Telephony (KURAL_MODE=telephony) ---

# Telephony provider — registry key. Currently registered: twilio.
KURAL_TELEPHONY_PROVIDER=twilio

# Publicly reachable base URL Twilio calls back into (webhooks + media
# stream). For local dev, run `ngrok http 8000` and paste its https URL.
# Required when KURAL_MODE=telephony.
KURAL_PUBLIC_BASE_URL=https://your-tunnel-or-host.example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
