# kural env config — copy to .env and edit

# Pipeline
KURAL_MODE=voice                       # voice (STT→LLM→TTS) or echo (passthrough)

# Audio
KURAL_SAMPLE_RATE=16000                # input rate (Whisper-optimal)
KURAL_OUTPUT_SAMPLE_RATE=24000         # output rate (TTS playback)
KURAL_LOG_LEVEL=INFO

# LLM provider — registry key in kural/adapters/registry.py.
# Currently registered: openai (OpenAI-compatible HTTP endpoint).
KURAL_LLM_PROVIDER=openai

# LLM (OpenAI-compatible). Examples:
#   OpenAI         base_url=https://api.openai.com/v1
#   OpenRouter     base_url=https://openrouter.ai/api/v1
#   Groq           base_url=https://api.groq.com/openai/v1
#   Ollama (local) base_url=http://localhost:11434/v1
KURAL_LLM_BASE_URL=http://localhost:11434/v1
KURAL_LLM_API_KEY=ollama
KURAL_LLM_MODEL=llama3.1:8b

# STT provider — registry key. Currently registered: whisper (faster-whisper).
KURAL_STT_PROVIDER=whisper

# STT model identifier (auto-downloaded on first run).
# Smaller/faster: tiny.en, base.en, small.en, distil-small.en, distil-medium.en
KURAL_STT_MODEL=distil-medium.en

# TTS provider — registry key. Currently registered: piper.
KURAL_TTS_PROVIDER=piper

# TTS voice identifier (auto-downloaded on first run).
# See https://github.com/rhasspy/piper-tts for the Piper voice catalogue.
KURAL_TTS_VOICE=en_US-amy-medium

# System prompt seeded into the LLM context.
# KURAL_AGENT_PROMPT="You are kural, a concise and friendly voice assistant."

# --- placeholders for later milestones ---

# Telephony (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
