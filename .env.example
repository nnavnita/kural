# kural env config — copy to .env and edit
# v0 echo agent uses no external APIs; later milestones add provider keys.

# Audio
KURAL_SAMPLE_RATE=16000
KURAL_LOG_LEVEL=INFO

# --- placeholders for later milestones ---

# LLM (OpenAI-compatible). Examples:
#   OpenAI         base_url=https://api.openai.com/v1
#   OpenRouter     base_url=https://openrouter.ai/api/v1
#   Groq           base_url=https://api.groq.com/openai/v1
#   Ollama (local) base_url=http://localhost:11434/v1
# KURAL_LLM_BASE_URL=
# KURAL_LLM_API_KEY=
# KURAL_LLM_MODEL=

# STT
# KURAL_STT_PROVIDER=whisper          # whisper | deepgram
# DEEPGRAM_API_KEY=

# TTS
# KURAL_TTS_PROVIDER=kokoro           # kokoro | piper | elevenlabs | cartesia
# ELEVENLABS_API_KEY=
# CARTESIA_API_KEY=

# Telephony (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
